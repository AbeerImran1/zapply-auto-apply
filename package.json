{
  "name": "zapply-auto-apply",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A bounded autopilot for Discord job listings that drafts and submits applications using an explicit candidate profile.",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "register-commands": "node src/register-commands.js",
    "login-browser": "node src/login-browser.js",
    "test": "node --test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "nodemailer": "^10.6.1",
    "openai": "^7.65.0",
    "pdfkit": "^0.21.0",
    "playwright": "^1.56.1"
  }
}